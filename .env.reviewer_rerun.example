# Reviewer-rerun environment template
#
# Copy this file to `.env` only on the experiment machine:
#
#   cp .env.reviewer_rerun.example .env
#   chmod 600 .env
#
# Fill in only the values needed for the next approved stage. The corrected
# reviewer scripts intentionally do not load `.env` automatically. Export its
# values into the current shell immediately before an approved API command:
#
#   set -a
#   . ./.env
#   set +a
#
# `.env` and other `.env.*` files are git-ignored. Never commit, print, paste
# into a run log, or return the real values in an evidence packet.

# Required only for explicitly approved teacher API stages: one-request
# preflight, Batch submission/status, and Batch download. It is not needed for
# bootstrap, offline data preparation, model training, or evaluation.
OPENAI_API_KEY=

# Optional. The frozen mlx-community model repositories are public, so the
# mandatory runs should not require a Hugging Face token. Set this only if the
# model host requires authentication; never replace a frozen public model with
# a gated model to work around a download problem.
HF_TOKEN=

# Optional storage relocation for Hugging Face datasets and model snapshots.
# Use an absolute path on a volume with sufficient free space. Set and record
# this before the first dataset/model download; changing it mid-run can create
# duplicate caches and invalidate storage estimates.
# HF_HOME=/absolute/path/to/reviewer-rerun-huggingface-cache

# Do not set SOCRATIQ_BOOTSTRAP_ALLOW_NON_M4 or
# SOCRATIQ_BOOTSTRAP_ALLOW_DIRTY for an official M4 bootstrap. Those variables
# exist only so automated tests can exercise the guard script safely.
