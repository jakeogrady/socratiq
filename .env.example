# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored and must never be committed.

# OpenAI — required only by `make conversion`, which generates the Socratic
# dataset through the Batch API. Training and evaluation do not need it.
# Create one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-replace-me

# Hugging Face — required to download gated base models, e.g. the `meta-llama`
# repositories referenced by src/constants.py. The `mlx-community` mirrors used
# throughout the Makefile are public, so this is only needed if a config points
# at a gated repository.
# Create one at https://huggingface.co/settings/tokens
HF_TOKEN=hf_replace-me
