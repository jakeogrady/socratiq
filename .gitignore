# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv/

# Secrets - never commit. See the legacy and reviewer-rerun templates.
.env
.env.*
!.env.example
!.env.reviewer_rerun.example

.idea/

wandb/
smollm_lora_test/

# converted dataset
src/data/**.jsonl

**adapters*/

# Training logs are tracked - they are the only record of loss curves,
# trainable parameter counts, peak memory and throughput.
*.log
!logs/*.log

# Reviewer-rerun data artifacts are generated locally. Keep their policy file
# and compact provenance manifests, but never raw JSONL or model artifacts.
data/*
!data/reviewer_rerun/
data/reviewer_rerun/**
!data/reviewer_rerun/README.md
!data/reviewer_rerun/**/
!data/reviewer_rerun/**/*.manifest.json
!data/reviewer_rerun/**/manifests/*.json

*evaluation_results.csv

**.jsonl

eval_results/**.csv

# Reviewer-rerun runtime artifacts. Compact JSON manifests and CSV summaries
# remain trackable; model weights, raw predictions and temporary files do not.
runs/reviewer_rerun/**/adapter/
runs/reviewer_rerun/**/*.safetensors
runs/reviewer_rerun/**/predictions.jsonl
runs/reviewer_rerun/**/*.tmp
results/reviewer_rerun/**/*.jsonl

# Revision-v2 (Phase 2). Weights, data files and run outputs stay local and
# travel by return packet; their hashes are tracked under configs/revision_v2/.
# Gate evidence under audit/phase2/ is tracked, including its small JSONL files.
models/
runs/revision_v2/
audit/downloads/
!audit/phase2/**/*.jsonl
